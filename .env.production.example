# ===========================================================================
# .env.production.example  —  本番用の環境変数テンプレート
# ===========================================================================
# 本番の実ファイル（.env.production）はリポジトリに置かず、デプロイ先の
# シークレット管理機構（環境変数 / Secrets Manager 等）で注入する。
# デプロイ先は未定（docs/requirements/todo.md #2、Phase 10 で確定）。
#
# ここにも「本物の値」は書かない。プレースホルダのみ。
# ===========================================================================

APP_ENV=production

# --- データベース（マネージド PostgreSQL 想定） -------------------
# 組み立てた実 URL はデプロイ先のシークレット管理で注入する。
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<db>

# --- 認証（JWT） -------------------------------------------------
# 本番用の署名鍵はシークレット管理で注入。開発・テストと共有しない。
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# --- オブジェクトストレージ（S3 互換のマネージドサービス想定） ---
# 本番は MinIO ではないので MINIO_ROOT_* は置かない。
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# --- ログ -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- AI 校正プロバイダ（Phase 11） -------------------------------
# 本番はクラウド LLM API。API キーはシークレット管理で注入する。
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- フロントエンド（expoApp）の環境変数はここには置かない ------
# Expo は `expoApp/` から .env を読む。本番の EXPO_PUBLIC_API_BASE_URL
# （HTTPS）は expoApp のビルド設定で注入する。
# `expoApp/.env.production.example` は Issue #34 で追加する。
