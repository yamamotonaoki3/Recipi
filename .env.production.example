# ===========================================================================
# .env.production.example  —  本番用の環境変数テンプレート
# ===========================================================================
# 本番の実ファイル（.env.production）はリポジトリに置かない。本番は AWS で、
# 値は ECS のタスク定義（環境変数）と Secrets Manager から注入する
# （infra/terraform/ecs.tf・secrets.tf）。このファイルは「どんな値が要るか」の一覧。
#
# ここにも「本物の値」は書かない。プレースホルダのみ。
# ===========================================================================

APP_ENV=production

# --- データベース（マネージド PostgreSQL 想定） -------------------
# 組み立てた実 URL はデプロイ先のシークレット管理で注入する。
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<db>

# 接続プール（Issue #191）。本番は ECS のタスク定義が明示的に渡す
# （infra/terraform/ecs.tf）。省略時は 10 / 10 / 5（app/config.py の既定値）。
# 同時に張る接続は DB_POOL_SIZE ＋ DB_MAX_OVERFLOW 本。タスク数を増やすときは、
# 「タスク数 × この合計」が RDS の max_connections を超えないことを確かめる。
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5

# --- 認証（JWT） -------------------------------------------------
# 本番用の署名鍵はシークレット管理で注入。開発・テストと共有しない。
JWT_SECRET_KEY=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth
CORS_ALLOW_CREDENTIALS=true
ACCESS_TOKEN_TTL_MINUTES=15
# ACCESS_TOKEN_TTL_SECONDS=<正の整数>   # 分より優先。E2E で短い寿命が要るときだけ
#                                      # コメントを外して正の整数に置き換える。
#                                      # 空文字（=だけ）は設定エラーになるので注意。
REFRESH_TOKEN_TTL_DAYS=60

# --- オブジェクトストレージ（AWS の S3 ＋ CloudFront。Issue #165・#166） ---
# 本番は MinIO ではないので MINIO_ROOT_* は置かない。
# エンドポイントとアクセスキーは空にする: AWS の標準エンドポイントと、ECS の
# タスクロールの一時的な認証情報を使う（アクセスキーをどこにも置かない）。
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 以下 3 つは必須（空だと起動しない）。
S3_REGION=<aws-region>
S3_BUCKET=<images-bucket-name>
# 画像の URL の基底。バケットは非公開なので CloudFront のドメインにする（https 必須）。
S3_PUBLIC_URL_BASE=https://<cloudfront-domain>

# --- クライアント IP（Issue #166）。必須 ---------------------------
# API Gateway の VPC Link の ENI が置かれる private サブネットの CIDR（カンマ区切り）。
# VPC 全体の CIDR にはしない（信頼する範囲を広げすぎないため）。
TRUSTED_PROXY_CIDRS=<private-subnet-cidr-1>,<private-subnet-cidr-2>

# --- CORS ---------------------------------------------------------
# 本番のフロント（Web / デスクトップ）のオリジンをカンマ区切りで。
CORS_ALLOW_ORIGINS=

# --- ログ -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# 監査ログの email_hash を作る鍵（32 文字以上のランダム値。未設定だと起動しない）。
# シークレット管理で注入する。開発・テストと共有しない。
LOG_HASH_SECRET=

# --- AI 校正プロバイダ（Phase 11） -------------------------------
# 本番はクラウド LLM API。API キーはシークレット管理で注入する。
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_PROVIDER_TIMEOUT_SECONDS=15
AI_HOURLY_LIMIT=20
AI_DAILY_LIMIT=100

# --- フロントエンド（expoApp）の環境変数はここには置かない ------
# Expo は `expoApp/` から .env を読む。本番の EXPO_PUBLIC_API_BASE_URL
# （HTTPS）は expoApp のビルド設定で注入する。
# `expoApp/.env.production.example` は Issue #34 で追加する。

# --- 画像アップロード（#39） ---------------------------------------
# 省略時は 3600 / 86400 / 5MiB / 1600px（app/config.py の既定値）。
# 値を変更する場合は、行頭の # を外して指定する（空文字のままだと整数に変換できない）。
# UPLOAD_PENDING_TTL_SECONDS=3600
# UPLOAD_STORED_TTL_SECONDS=86400
# IMAGE_MAX_BYTES=5242880
# IMAGE_MAX_DIMENSION=2048

# --- 定期ジョブの保持期間・上限（#72・#85） ------------------------------
# 省略時は 90 / 7 / 30 / 200 / 1（app/config.py の既定値）。どれも 1 以上。
# 値を変更する場合は、行頭の # を外して指定する（空文字のままだと整数に変換できない）。
# NOTIFICATION_READ_RETENTION_DAYS=90
# OUTBOX_PROCESSED_RETENTION_DAYS=7
# REFRESH_TOKEN_EXPIRED_RETENTION_DAYS=30
# RECIPE_VIEWS_MAX_PER_USER=200
# PASSWORD_RESET_ATTEMPT_RETENTION_DAYS=1
# REAUTH_ATTEMPT_RETENTION_DAYS=1
