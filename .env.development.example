# ===========================================================================
# .env.development.example  —  ローカル開発用の環境変数テンプレート
# ===========================================================================
# 使い方:
#   1. このファイルを `.env.development` にコピーする
#        cp .env.development.example .env.development
#   2. `changeme` / `<...>` の箇所を自分で決めた値に置き換える（下のメモ参照）
#   3. インフラを起動（compose は .env.development を自動で読まないので --env-file が要る）
#        docker compose --env-file .env.development -f infra/docker-compose.yml up -d postgres minio
#   詳しい手順はリポジトリルートの README.md
#
# `.env.development` は .gitignore で除外されるのでコミットされない。
# このテンプレート（.example）には「本物の値」を書かないこと。
# 全変数の意味は docs/requirements/environment.md を参照。
# ===========================================================================

# --- 実行環境の選択 --------------------------------------------------------
# development / test / production のどれか。バックエンドはこれを見て
# .env.<APP_ENV> を読み込む。
APP_ENV=development

# --- データベース（PostgreSQL） -----------------------------------------
# DATABASE_URL は SQLAlchemy の形式。<...> を実際の値に置き換える。
#
# <host> は「バックエンドをどこで動かすか」で変わる:
#   - ホストで uvicorn を動かす（README の手順）      → localhost
#   - docker compose の `api` サービスとして動かす    → postgres
#     （compose の api サービスが environment: で上書きする想定）
# 例（ホスト実行）: postgresql+psycopg://recipi:MY_LOCAL_PW@localhost:5432/recipi
# （組み立てた実 URL は .env.development にだけ書く。ここはテンプレートのまま）
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<db>

# docker compose の postgres コンテナが使う値。
# DATABASE_URL の user / password / db と一致させること。
POSTGRES_DB=recipi
POSTGRES_USER=recipi
POSTGRES_PASSWORD=changeme          # ← 自分で決めたパスワード（root/password/admin は使わない）

# --- 認証（JWT） --------------------------------------------------------
# アクセストークンの署名鍵。長いランダム文字列を生成して入れる。
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-generate-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15         # アクセストークンの寿命（分）
REFRESH_TOKEN_TTL_DAYS=60           # リフレッシュトークンの寿命（日）

# --- オブジェクトストレージ（開発は MinIO） ---------------------------
# S3_ENDPOINT_URL はバックエンドが MinIO に接続する先。
#   - ホストで uvicorn        → http://localhost:9000
#   - compose の api サービス → http://minio:9000（api サービスが上書き）
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1                 # MinIO では任意の値でよい
S3_BUCKET=recipi-images
S3_ACCESS_KEY_ID=changeme           # MINIO_ROOT_USER と同じ値にする
S3_SECRET_ACCESS_KEY=changeme       # MINIO_ROOT_PASSWORD と同じ値にする

# S3_PUBLIC_URL_BASE は「ブラウザ / アプリが画像を読む URL」。フロントの
# EXPO_PUBLIC_API_BASE_URL と同じ「開発ホストの指し方」に合わせる:
#   - Web / デスクトップ / iOS シミュレータ → localhost
#   - Android エミュレータ                  → 10.0.2.2
#   - 実機                                  → 開発マシンの LAN IP
S3_PUBLIC_URL_BASE=http://localhost:9000/recipi-images

# docker compose の minio コンテナのルート資格情報。
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY と一致させる。
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# --- CORS（Web / Tauri からの API 呼び出しを許可するオリジン） --------
# カンマ区切り。Expo Web(8081) / 旧ポート(19006) / Tauri 各種。
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:1420,http://tauri.localhost,tauri://localhost

# --- ログ -------------------------------------------------------------
LOG_LEVEL=DEBUG                     # 開発は DEBUG、本番は INFO
LOG_FORMAT=json                     # 構造化ログ（json / text）

# --- AI 校正プロバイダ（Phase 11 で使用。今は枠だけ） ----------------
# development はローカル推論を使う想定。
AI_PROVIDER=local

# --- フロントエンド（expoApp）の環境変数はここには置かない --------
# Expo は `expoApp/` ディレクトリから .env を読むため、フロントの変数
# （EXPO_PUBLIC_API_BASE_URL など）は `expoApp/.env.development` に置く。
# テンプレート `expoApp/.env.*.example` は expoApp を作成する Issue #34 で
# 追加する。詳細は docs/requirements/environment.md §2。
