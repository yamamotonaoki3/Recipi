            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "nullable": true,
                "type": "object"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
