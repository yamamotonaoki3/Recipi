            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngredientGroupInput": {
        "properties": {
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientInput"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Ingredients",
            "type": "array"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "ingredients"
        ],
        "title": "IngredientGroupInput",
        "type": "object"
      },
      "IngredientGroupOutput": {
        "properties": {
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientOutput"
            },
            "title": "Ingredients",
            "type": "array"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "name",
          "ingredients"
        ],
        "title": "IngredientGroupOutput",
        "type": "object"
      },
      "IngredientInput": {
        "properties": {
          "name": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,7}|(?=[\\d.]{1,11}0*$)\\d{0,7}\\.\\d{0,3}0*$)",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "refRecipeId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refrecipeid"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "required": [
          "name"
        ],
        "title": "IngredientInput",
        "type": "object"
      },
      "IngredientOutput": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "placement": {
            "title": "Placement",
            "type": "string"
          },
          "quantity": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "refRecipe": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RefRecipe"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "required": [
          "name",
          "quantity",
          "unit",
          "placement",
          "refRecipe"
        ],
        "title": "IngredientOutput",
        "type": "object"
      },
