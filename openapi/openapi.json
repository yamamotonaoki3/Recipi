            "title": "Description",
            "type": "string"
          },
          "favoriteCount": {
            "title": "Favoritecount",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ingredientGroups": {
            "items": {
              "$ref": "#/components/schemas/IngredientGroupOutput"
            },
            "title": "Ingredientgroups",
            "type": "array"
          },
          "isFavorited": {
            "title": "Isfavorited",
            "type": "boolean"
          },
          "isPublic": {
            "title": "Ispublic",
