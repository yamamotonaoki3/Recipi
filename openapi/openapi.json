        "type": "object"
      },
      "RecipeSummary": {
        "description": "自分のレシピ一覧のカード 1 枚分（features/recipe.md §2「自分のレシピ一覧」）。",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "isPublic": {
            "title": "Ispublic",
            "type": "boolean"
          },
          "thumbnailUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnailurl"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "thumbnailUrl",
          "isPublic",
          "createdAt"
        ],
        "title": "RecipeSummary",
        "type": "object"
      },
      "RecipeWriteRequest": {
        "description": "`POST /recipes` と `PUT /recipes/{id}` 共通のリクエスト body。\n\n`PUT` の「`thumbnailKey` 省略 = サムネイル変更なし」は、ルーター側で\n`model_fields_set` に `\"thumbnail_key\"` が含まれるかで判定する\n（features/recipe.md §5「省略 = 変更なし / null = 削除 / 既存キー再送 = 維持 /\n新キー = 差し替え」）。",
        "properties": {
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "ingredientGroups": {
            "items": {
              "$ref": "#/components/schemas/IngredientGroupInput"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Ingredientgroups",
            "type": "array"
          },
          "isPublic": {
            "default": false,
            "title": "Ispublic",
            "type": "boolean"
          },
          "servings": {
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Servings",
            "type": "integer"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepInput"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Steps",
            "type": "array"
          },
          "thumbnailKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnailkey"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "servings",
          "ingredientGroups",
          "steps"
        ],
        "title": "RecipeWriteRequest",
        "type": "object"
      },
