# README 用デモ環境。実体は .env.demo として作成し、秘密値は書き込まない。
# まず .env.development の値をコピーし、APP_ENV と DATABASE_URL の DB 名だけを
# recipi_demo に変更する。POSTGRES_* / MINIO_* の値はローカル開発環境と一致させる。

APP_ENV=demo
DATABASE_URL=postgresql+psycopg://<development-user>:<development-password>@localhost:5432/recipi_demo

# compose の初回起動時に使う値。既存の開発用 compose と同じ資格情報にする。
POSTGRES_DB=recipi_demo
POSTGRES_USER=<development-user>
POSTGRES_PASSWORD=<development-password>

JWT_SECRET_KEY=<development-jwt-secret>
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60
AUTH_COOKIE_NAME=recipi_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth
CORS_ALLOW_CREDENTIALS=true

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=recipi-images
S3_ACCESS_KEY_ID=<development-minio-user>
S3_SECRET_ACCESS_KEY=<development-minio-password>
S3_PUBLIC_URL_BASE=http://localhost:9000/recipi-images
MINIO_ROOT_USER=<development-minio-user>
MINIO_ROOT_PASSWORD=<development-minio-password>

CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:1420,http://tauri.localhost,tauri://localhost
LOG_LEVEL=INFO
LOG_FORMAT=text
AI_PROVIDER=local

NOTIFICATION_READ_RETENTION_DAYS=90
OUTBOX_PROCESSED_RETENTION_DAYS=7
REFRESH_TOKEN_EXPIRED_RETENTION_DAYS=30
RECIPE_VIEWS_MAX_PER_USER=200
PASSWORD_RESET_ATTEMPT_RETENTION_DAYS=1
