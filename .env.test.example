# ===========================================================================
# .env.test.example  —  自動テスト用の環境変数テンプレート
# ===========================================================================
# 使い方（ローカル）:
#   cp .env.test.example .env.test   → 値を埋める → APP_ENV=test で pytest
# CI（GitHub Actions）では、このテンプレートからワークフローが .env.test を
# 生成する（秘密でない値は直書き、本物の秘密が要る場合だけ Actions Secrets）。
#
# テストの接続先は「ローカル or CI の使い捨て DB / ストレージ」に限定する。
# 本番・ステージングには絶対につながない（docs/requirements/non-functional.md）。
# ===========================================================================

APP_ENV=test

# --- データベース（テスト専用・使い捨て） ---------------------------
# ローカル: compose の postgres コンテナ内の **別データベース** recipi_test を使う
#   （postgres-init/01-create-test-db.sql が初回起動時に作る。所有者は
#    .env.development の POSTGRES_USER）。
#   → user / password は **.env.development と同じ**、DB 名だけ recipi_test:
#      DATABASE_URL=postgresql+psycopg://<dev と同じ user>:<dev と同じ pw>@localhost:5432/recipi_test
# CI: GitHub Actions の postgres service（user=pw=db=recipi_test）を使う。
#     backend.yml が下の DATABASE_URL を service に合わせて上書きする。
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/recipi_test

# --- 認証（テスト用の固定値でよい） -------------------------------
JWT_SECRET_KEY=test-only-not-a-real-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# --- オブジェクトストレージ（開発と同じ compose の MinIO を使う） --
# バケットだけテスト用に分ける。user/pw は .env.development と同じにする。
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=recipi-images-test
S3_ACCESS_KEY_ID=<dev と同じ>
S3_SECRET_ACCESS_KEY=<dev と同じ>
S3_PUBLIC_URL_BASE=http://localhost:9000/recipi-images-test

# --- CORS（テストでは既定でよい） --------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8081

# --- ログ -----------------------------------------------------------
LOG_LEVEL=WARNING
LOG_FORMAT=json

# --- AI 校正プロバイダ --------------------------------------------
# test は決定的なスタブ（モデルも API キーも不要）。
AI_PROVIDER=stub

# --- フロントエンド（expoApp）の環境変数はここには置かない ------
# Expo は `expoApp/` から .env を読む。フロントのテストは MSW で API を
# モックするので実サーバーは不要。E2E（Maestro）はローカル compose の
# バックエンドを指す。`expoApp/.env.test.example` は Issue #34 で追加する。
